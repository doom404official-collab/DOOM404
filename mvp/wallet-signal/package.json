{
  "name": "doom404-wallet-signal",
  "version": "0.1.0",
  "private": true,
  "description": "DOOM404 Wallet Signal - Solana wallet analytics MVP",
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:smoke && npm run validate:creator:extra-accounts && next build",
    "start": "next start",
    "test:smoke": "node --test tests/*.test.mjs",
    "check": "npm run build",
    "test:creator": "node --test tests/*creator*.test.mjs tests/pump-fun-creation.test.mjs tests/launchpad-creation-verifier.test.mjs",
    "validate:creator:preview": "node scripts/preview-creator-validation.mjs",
    "validate:creator:indexed": "node scripts/preview-indexed-creator-validation.mjs",
    "validate:creator:helius-index": "node scripts/preview-helius-index-validation.mjs",
    "validate:creator:pumpfun": "node scripts/preview-pumpfun-creator-validation.mjs",
    "validate:creator:wallet": "node scripts/preview-creator-wallet-validation.mjs",
    "validate:creator:evidence": "node scripts/preview-creation-evidence-audit.mjs",
    "validate:creator:matrix": "node scripts/preview-creator-matrix.mjs",
    "validate:creator:mint-matrix": "node scripts/preview-creator-mint-matrix.mjs",
    "validate:creator:schema-matrix": "node scripts/preview-pumpfun-schema-matrix.mjs",
    "validate:creator:timed": "node scripts/preview-helius-timed-validation.mjs",
    "validate:creator:timed-matrix": "node scripts/preview-creator-timed-matrix.mjs",
    "validate:vault:preview": "node scripts/preview-intelligence-vault-check.mjs",
    "validate:vault:seed-once": "node scripts/preview-vault-seed-once.mjs",
    "validate:creator:focused": "node scripts/preview-creator-focused-diagnostic.mjs",
    "validate:creator:resume": "node scripts/preview-creator-resume-diagnostic.mjs",
    "validate:creator:reject-review": "node scripts/preview-creator-reject-review.mjs",
    "validate:creator:layout-audit": "node scripts/preview-creator-layout-audit.mjs",
    "validate:creator:extra-accounts": "node scripts/preview-creator-extra-account-audit.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
